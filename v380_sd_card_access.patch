+part of '../../main.dart';
+
+/// One recording stored on the camera SD card, as reported by ONVIF.
+class SdCardRecording {
+  const SdCardRecording({
+    required this.token,
+    this.name,
+    this.earliest,
+    this.latest,
+  });
+
+  final String token;
+  final String? name;
+  final DateTime? earliest;
+  final DateTime? latest;
+
+  String get displayName {
+    final cleanName = name?.trim();
+    if (cleanName != null && cleanName.isNotEmpty) {
+      return cleanName;
+    }
+    return 'Recording $token';
+  }
+
+  String get displayRange {
+    String label(DateTime? value) {
+      if (value == null) {
+        return 'unknown';
+      }
+      final local = value.toLocal();
+      return '${local.year}-${local.month.toString().padLeft(2, '0')}-${local.day.toString().padLeft(2, '0')} '
+          '${local.hour.toString().padLeft(2, '0')}:${local.minute.toString().padLeft(2, '0')}';
+    }
+
+    return '${label(earliest)} to ${label(latest)}';
+  }
+}
+
+/// Reads SD card recordings from an ONVIF Profile G camera (search + replay
+/// services) and resolves RTSP replay URLs that FijkPlayer can play.
+///
+/// V380 Pro exposes ONVIF on port 8899 when it is enabled in the V380 Pro
+/// app (Settings > ONVIF). Whether recording search is supported depends on
+/// the firmware: some builds only expose live streaming and PTZ over ONVIF,
+/// in which case the calls below fail with a clear message and the SD card
+/// can only be read through the vendor app or by mounting the card directly.
+class _OnvifSdCardClient {
+  _OnvifSdCardClient(this.settings) : _soap = _OnvifPtzClient(settings);
+
+  static const _searchPaths = ['/onvif/search_service', '/onvif/search'];
+  static const _replayPaths = ['/onvif/replay_service', '/onvif/replay'];
+  static const _recordingPaths = [
+    '/onvif/recording_service',
+    '/onvif/recording',
+  ];
+
+  final _OnvifPtzSettings settings;
+  final _OnvifPtzClient _soap;
+  int? _resolvedPort;
+
+  List<int> get _candidatePorts {
+    final fixedPort = settings.port ?? _resolvedPort;
+    if (fixedPort != null) {
+      return [fixedPort];
+    }
+    return _OnvifPtzClient._automaticPorts;
+  }
+
+  Future<List<SdCardRecording>> listRecordings() async {
+    Object? lastError;
+    for (final port in _candidatePorts) {
+      try {
+        final recordings = await _listRecordingsOnPort(port);
+        _resolvedPort = port;
+        return recordings;
+      } catch (error) {
+        lastError = error;
+      }
+    }
+
+    throw _OnvifPtzException(
+      'Could not list SD card recordings on ${settings.host}. Enable ONVIF '
+      'in the V380 Pro app and check the ONVIF username and password. If it '
+      'still fails, this firmware does not expose SD playback over ONVIF. '
+      '${_soap._errorSummary(lastError)}',
+    );
+  }
+
+  Future<List<SdCardRecording>> _listRecordingsOnPort(int port) async {
+    Object? searchError;
+    try {
+      return await _listViaSearchService(port);
+    } catch (error) {
+      searchError = error;
+    }
+
+    try {
+      return await _listViaRecordingService(port);
+    } catch (error) {
+      throw _OnvifPtzException(
+        'Recording search failed on port $port: '
+        '${_soap._errorSummary(searchError)} / ${_soap._errorSummary(error)}',
+      );
+    }
+  }
+
+  Future<List<SdCardRecording>> _listViaSearchService(int port) async {
+    final searchUri = _firstWorkingUri(port, _searchPaths);
+    final findResponse = await _soap._postSoap(
+      searchUri,
+      action: 'http://www.onvif.org/ver10/search/wsdl/FindRecordings',
+      body: '''
+<tse:FindRecordings xmlns:tse="http://www.onvif.org/ver10/search/wsdl">
+  <tse:Scope/>
+  <tse:KeepAliveTime>PT10S</tse:KeepAliveTime>
+</tse:FindRecordings>''',
+    );
+
+    final searchToken = _firstXmlElement(
+      findResponse,
+      'SearchToken',
+    )?.innerText.trim();
+    if (searchToken == null || searchToken.isEmpty) {
+      throw const _OnvifPtzException(
+        'The camera did not return a recording search token.',
+      );
+    }
+
+    final resultsResponse = await _soap._postSoap(
+      searchUri,
+      action:
+          'http://www.onvif.org/ver10/search/wsdl/GetRecordingSearchResults',
+      body:
+          '''
+<tse:GetRecordingSearchResults xmlns:tse="http://www.onvif.org/ver10/search/wsdl">
+  <tse:SearchToken>${_xmlEscape(searchToken)}</tse:SearchToken>
+  <tse:WaitTime>PT5S</tse:WaitTime>
+</tse:GetRecordingSearchResults>''',
+    );
+
+    final recordings = <SdCardRecording>[];
+    for (final info in _xmlElements(resultsResponse, 'RecordingInformation')) {
+      final token = _firstXmlElement(info, 'RecordingToken')?.innerText.trim();
+      if (token == null || token.isEmpty) {
+        continue;
+      }
+      recordings.add(
+        SdCardRecording(
+          token: token,
+          name: _firstXmlElement(info, 'Name')?.innerText,
+          earliest: DateTime.tryParse(
+            _firstXmlElement(info, 'EarliestRecording')?.innerText.trim() ??
+                '',
+          ),
+          latest: DateTime.tryParse(
+            _firstXmlElement(info, 'LatestRecording')?.innerText.trim() ?? '',
+          ),
+        ),
+      );
+    }
+    return recordings;
+  }
+
+  Future<List<SdCardRecording>> _listViaRecordingService(int port) async {
+    final recordingUri = _firstWorkingUri(port, _recordingPaths);
+    final response = await _soap._postSoap(
+      recordingUri,
+      action: 'http://www.onvif.org/ver10/recording/wsdl/GetRecordings',
+      body:
+          '<trc:GetRecordings xmlns:trc="http://www.onvif.org/ver10/recording/wsdl"/>',
+    );
+
+    final recordings = <SdCardRecording>[];
+    for (final item in _xmlElements(response, 'RecordingItem')) {
+      final token = _firstXmlElement(item, 'RecordingToken')?.innerText.trim();
+      if (token == null || token.isEmpty) {
+        continue;
+      }
+      recordings.add(
+        SdCardRecording(
+          token: token,
+          name: _firstXmlElement(item, 'Name')?.innerText,
+        ),
+      );
+    }
+    return recordings;
+  }
+
+  /// Resolves the RTSP URL that plays back [recording] from the SD card,
+  /// with the camera credentials embedded so FijkPlayer can authenticate.
+  Future<String> replayUrl(SdCardRecording recording) async {
+    Object? lastError;
+    for (final port in _candidatePorts) {
+      for (final path in _replayPaths) {
+        try {
+          final response = await _soap._postSoap(
+            _soap._serviceUri(port, path),
+            action: 'http://www.onvif.org/ver10/replay/wsdl/GetReplayUri',
+            body:
+                '''
+<trp:GetReplayUri xmlns:trp="http://www.onvif.org/ver10/replay/wsdl">
+  <trp:StreamSetup>
+    <tt:Stream>RTP-Unicast</tt:Stream>
+    <tt:Transport>
+      <tt:Protocol>RTSP</tt:Protocol>
+    </tt:Transport>
+  </trp:StreamSetup>
+  <trp:RecordingToken>${_xmlEscape(recording.token)}</trp:RecordingToken>
+</trp:GetReplayUri>''',
+          );
+
+          final rawUri = _firstXmlElement(response, 'Uri')?.innerText.trim();
+          if (rawUri == null || rawUri.isEmpty) {
+            throw const _OnvifPtzException(
+              'The camera returned an empty replay URL.',
+            );
+          }
+          return _replayUrlWithCredentials(rawUri);
+        } catch (error) {
+          lastError = error;
+        }
+      }
+    }
+
+    throw _OnvifPtzException(
+      'Could not get a replay URL for ${recording.displayName}: '
+      '${_soap._errorSummary(lastError)}',
+    );
+  }
+
+  Uri _firstWorkingUri(int port, List<String> paths) {
+    return _soap._serviceUri(port, paths.first);
+  }
+
+  String _replayUrlWithCredentials(String rawUrl) {
+    var uri = Uri.tryParse(rawUrl);
+    if (uri == null) {
+      return rawUrl;
+    }
+    if (uri.host.isEmpty || uri.host == '0.0.0.0') {
+      uri = uri.replace(host: settings.host);
+    }
+    if (settings.username.isNotEmpty && uri.userInfo.isEmpty) {
+      uri = uri.replace(
+        userInfo:
+            '${Uri.encodeComponent(settings.username)}:${Uri.encodeComponent(settings.password)}',
+      );
+    }
+    return uri.toString();
+  }
+
+  void close() {
+    _soap.close();
+  }
+}
+
+/// Bottom sheet listing SD card recordings; tapping one opens playback.
+class SdCardRecordingsSheet extends StatefulWidget {
+  const SdCardRecordingsSheet({super.key, required this.streamUrl});
+
+  final String streamUrl;
+
+  static Future<void> show(BuildContext context, String streamUrl) {
+    return showModalBottomSheet<void>(
+      context: context,
+      isScrollControlled: true,
+      showDragHandle: true,
+      builder: (context) {
+        return SdCardRecordingsSheet(streamUrl: streamUrl);
+      },
+    );
+  }
+
+  @override
+  State<SdCardRecordingsSheet> createState() => _SdCardRecordingsSheetState();
+}
+
+class _SdCardRecordingsSheetState extends State<SdCardRecordingsSheet> {
+  _OnvifSdCardClient? _client;
+  List<SdCardRecording>? _recordings;
+  String? _error;
+  bool _openingPlayback = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _loadRecordings();
+  }
+
+  @override
+  void dispose() {
+    _client?.close();
+    super.dispose();
+  }
+
+  Future<void> _loadRecordings() async {
+    setState(() {
+      _recordings = null;
+      _error = null;
+    });
+
+    try {
+      final uri = Uri.tryParse(widget.streamUrl);
+      final host = uri?.host ?? '';
+      if (host.isEmpty) {
+        throw const FormatException(
+          'The selected RTSP stream has no camera IP.',
+        );
+      }
+
+      final credentials = _cameraCredentialsFromRtspUrl(widget.streamUrl);
+      _client?.close();
+      final client = _OnvifSdCardClient(
+        _OnvifPtzSettings(
+          host: host,
+          username: credentials.username.isEmpty
+              ? 'admin'
+              : credentials.username,
+          password: credentials.password,
+        ),
+      );
+      _client = client;
+
+      final recordings = await client.listRecordings();
+      if (!mounted) {
+        return;
+      }
+      setState(() {
+        _recordings = recordings;
+      });
+    } catch (error) {
+      if (!mounted) {
+        return;
+      }
+      setState(() {
+        _error = error.toString();
+      });
+    }
+  }
+
+  Future<void> _openRecording(SdCardRecording recording) async {
+    final client = _client;
+    if (client == null || _openingPlayback) {
+      return;
+    }
+
+    setState(() {
+      _openingPlayback = true;
+    });
+    try {
+      final replayUrl = await client.replayUrl(recording);
+      if (!mounted) {
+        return;
+      }
+      await Navigator.of(context).push(
+        MaterialPageRoute<void>(
+          builder: (context) {
+            return SdCardPlaybackPage(
+              title: recording.displayName,
+              replayUrl: replayUrl,
+            );
+          },
+        ),
+      );
+    } catch (error) {
+      if (!mounted) {
+        return;
+      }
+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(content: Text(error.toString())),
+      );
+    } finally {
+      if (mounted) {
+        setState(() {
+          _openingPlayback = false;
+        });
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final recordings = _recordings;
+    return SafeArea(
+      child: Padding(
+        padding: const EdgeInsets.fromLTRB(18, 4, 18, 18),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Row(
+              children: [
+                const Icon(Icons.sd_card_outlined),
+                const SizedBox(width: 10),
+                const Expanded(
+                  child: Text(
+                    'SD Card Recordings',
+                    style: TextStyle(fontWeight: FontWeight.w900),
+                  ),
+                ),
+                IconButton(
+                  tooltip: 'Reload',
+                  onPressed: _loadRecordings,
+                  icon: const Icon(Icons.refresh),
+                ),
+              ],
+            ),
+            const SizedBox(height: 8),
+            if (_error case final error?)
+              Padding(
+                padding: const EdgeInsets.symmetric(vertical: 12),
+                child: Text(
+                  error,
+                  style: const TextStyle(height: 1.4),
+                ),
+              )
+            else if (recordings == null)
+              const Padding(
+                padding: EdgeInsets.symmetric(vertical: 28),
+                child: Center(child: CircularProgressIndicator()),
+              )
+            else if (recordings.isEmpty)
+              const Padding(
+                padding: EdgeInsets.symmetric(vertical: 12),
+                child: Text(
+                  'The camera answered, but reported no recordings on the '
+                  'SD card.',
+                ),
+              )
+            else
+              Flexible(
+                child: ListView.builder(
+                  shrinkWrap: true,
+                  itemCount: recordings.length,
+                  itemBuilder: (context, index) {
+                    final recording = recordings[index];
+                    return ListTile(
+                      leading: const Icon(Icons.videocam_outlined),
+                      title: Text(recording.displayName),
+                      subtitle: Text(recording.displayRange),
+                      trailing: _openingPlayback
+                          ? const SizedBox(
+                              width: 18,
+                              height: 18,
+                              child: CircularProgressIndicator(strokeWidth: 2),
+                            )
+                          : const Icon(Icons.play_arrow_rounded),
+                      onTap: () {
+                        unawaited(_openRecording(recording));
+                      },
+                    );
+                  },
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+/// Plays one SD card recording through the camera's RTSP replay stream.
+class SdCardPlaybackPage extends StatefulWidget {
+  const SdCardPlaybackPage({
+    super.key,
+    required this.title,
+    required this.replayUrl,
+  });
+
+  final String title;
+  final String replayUrl;
+
+  @override
+  State<SdCardPlaybackPage> createState() => _SdCardPlaybackPageState();
+}
+
+class _SdCardPlaybackPageState extends State<SdCardPlaybackPage> {
+  final FijkPlayer _player = FijkPlayer();
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_startPlayback());
+  }
+
+  Future<void> _startPlayback() async {
+    final options = FijkOption()
+      ..setPlayerOption('framedrop', 1)
+      ..setFormatOption('rtsp_transport', 'tcp')
+      ..setFormatOption('stimeout', 5000000);
+    try {
+      await _player.applyOptions(options);
+      await _player.setDataSource(widget.replayUrl, autoPlay: true);
+    } catch (_) {
+      // Errors surface through the player state in FijkView.
+    }
+  }
+
+  @override
+  void dispose() {
+    unawaited(_player.release().catchError((_) {}));
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      backgroundColor: Colors.black,
+      appBar: AppBar(
+        title: Text(widget.title),
+        backgroundColor: Colors.black,
+        foregroundColor: Colors.white,
+      ),
+      body: FijkView(
+        player: _player,
+        fit: FijkFit.contain,
+        color: Colors.black,
+      ),
+    );
+  }
+}
