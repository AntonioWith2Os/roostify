rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
// users/{uid}: private profile and immutable role for one Auth UID.
// Required fields: uid, username, displayName, email, role,
// cameraAccessEnabled, contactNumber, address, facebookContact, farmName,
// shortBio, createdAt, updatedAt. Optional: passwordResetAt.
//
// farms/{uid}/status/latest: latest environment sensor values.
// farms/{uid}/sensorReadings/{readingId}: immutable historical sensor values.
// Sensor fields: ownerUid, temperature, humidity, airPpm, dhtAvailable,
// airAvailable, updatedAt; historical records also include createdAt.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged(data, uid) {
      return data.uid == uid;
    }

    function uidNotModified(data) {
      return data.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveFarmOwner(uid) {
      return isOwner(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'user';
    }

    function isValidEmail(value) {
      return value is string
        && value.size() <= 254
        && (value.size() == 0 || value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'));
    }

    function isValidUser(data) {
      return data.keys().hasAll([
          'uid', 'username', 'displayName', 'email', 'role',
          'cameraAccessEnabled', 'contactNumber', 'address',
          'facebookContact', 'farmName', 'shortBio', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'username', 'displayName', 'email', 'role',
          'cameraAccessEnabled', 'contactNumber', 'address',
          'facebookContact', 'farmName', 'shortBio', 'createdAt', 'updatedAt',
          'passwordResetAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.username is string
        && data.username.size() >= 3 && data.username.size() <= 32
        && data.username.matches('^[a-z0-9._-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && isValidEmail(data.email)
        && data.role in ['admin', 'user']
        && data.cameraAccessEnabled is bool
        && data.contactNumber is string && data.contactNumber.size() <= 32
        && data.address is string && data.address.size() <= 240
        && data.facebookContact is string && data.facebookContact.size() <= 120
        && data.farmName is string && data.farmName.size() <= 120
        && data.shortBio is string && data.shortBio.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('passwordResetAt' in data) || data.passwordResetAt is timestamp);
    }

    function isValidSensor(data, historical) {
      let required = historical
        ? ['ownerUid', 'temperature', 'humidity', 'airPpm', 'dhtAvailable',
           'airAvailable', 'updatedAt', 'createdAt']
        : ['ownerUid', 'temperature', 'humidity', 'airPpm', 'dhtAvailable',
           'airAvailable', 'updatedAt'];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(required)
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.temperature is number
        && data.temperature >= -50 && data.temperature <= 100
        && data.humidity is number
        && data.humidity >= 0 && data.humidity <= 100
        && data.airPpm is int
        && data.airPpm >= 0 && data.airPpm <= 100000
        && data.dhtAvailable is bool
        && data.airAvailable is bool
        && data.updatedAt is timestamp
        && (!historical || data.createdAt is timestamp);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && uidUnchanged(request.resource.data, uid)
        && request.resource.data.role == 'user'
        && request.resource.data.cameraAccessEnabled == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidUser(request.resource.data);
      allow update: if isValidUser(request.resource.data)
        && uidNotModified(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role == resource.data.role
        && request.resource.data.updatedAt == request.time
        && (
          (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'email', 'contactNumber', 'address',
              'facebookContact', 'farmName', 'shortBio', 'updatedAt'
            ]))
          ||
          (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'email', 'contactNumber', 'address',
              'facebookContact', 'farmName', 'shortBio',
              'cameraAccessEnabled', 'updatedAt'
            ]))
        );
      allow delete: if false;
    }

    match /farms/{ownerUid}/status/{statusId} {
      allow read: if isOwner(ownerUid) || isAdmin();
      allow create: if statusId == 'latest'
        && isActiveFarmOwner(ownerUid)
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.updatedAt == request.time
        && isValidSensor(request.resource.data, false);
      allow update: if statusId == 'latest'
        && isActiveFarmOwner(ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.updatedAt == request.time
        && isValidSensor(request.resource.data, false);
      allow delete: if false;
    }

    match /farms/{ownerUid}/sensorReadings/{readingId} {
      allow read: if isOwner(ownerUid) || isAdmin();
      allow create: if isActiveFarmOwner(ownerUid)
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidSensor(request.resource.data, true);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
